": []}, {"t": "-", "a": 431, "b": null, "text": "\t._evt_content ._caution._type2 > ul > li._deco{padding-left: 0;}", "spans": []}, {"t": "-", "a": 432, "b": null, "text": "\t._evt_content ._caution._type2 > ul > li._pl{padding-left: 2.4vw;}", "spans": []}, {"t": "-", "a": 433, "b": null, "text": "\t._evt_content ._caution._type2 > ul > li._deco::before {display: none;}", "spans": []}, {"t": "-", "a": 434, "b": null, "text": "\t._evt_content ._caution._type2 > ul > li._margin{margin-left: 2.6666vw;}", "spans": []}, {"t": "-", "a": 435, "b": null, "text": "\t._evt_content ._caution._type2 > ul > li{display: flex;}", "spans": []}, {"t": "-", "a": 436, "b": null, "text": "\t._evt_content ._caution._type2 > ul > li ._mark{margin-right: 0.6666vw;}", "spans": []}, {"t": " ", "a": 437, "b": 424, "text": ""}, {"t": " ", "a": 438, "b": 425, "text": "\t._evt_content ._evt_caution dl * {color:#666;}"}, {"t": " ", "a": 439, "b": 426, "text": "\t._evt_content ._evt_caution dl dt {font-size:3.46667vw; line-height: 5.2vw; font-weight:700;}"}]}, {"lines": [{"t": " ", "a": 538, "b": 525, "text": "\t\t<div class=\"_area_wrap\">"}, {"t": " ", "a": 539, "b": 526, "text": "\t\t\t<div class=\"_top\">"}, {"t": " ", "a": 540, "b": 527, "text": "\t\t\t\t<span class=\"_logo\"><em class=\"_evt_hide\">삼성카드</em></span>"}, {"t": "-", "a": 541, "b": null, "text": "\t\t\t\t<span class=\"_date\">2026.10.5 ~ 2026.10.7</span>", "spans": [[32, 33], [44, 45]]}, {"t": "+", "a": null, "b": 528, "text": "\t\t\t\t<span class=\"_date\">2026.10.1 ~ 2026.10.25</span>", "spans": [[32, 33], [44, 46]]}, {"t": " ", "a": 542, "b": 529, "text": "\t\t\t</div>"}, {"t": " ", "a": 543, "b": 530, "text": "\t\t\t<div class=\"_desc\">"}, {"t": " ", "a": 544, "b": 531, "text": "\t\t\t\t<div class=\"_sub\">삼성카드 결제 시</div>"}, {"t": "-", "a": 545, "b": null, "text": "\t\t\t\t<div class=\"_title\"><em>10%</em><br>결제일 할인</div>", "spans": [[42, 46]]}, {"t": "+", "a": null, "b": 532, "text": "\t\t\t\t<div class=\"_title\">최대 <em>10%</em><br>결제쿠폰</div>", "spans": [[24, 27], [45, 47]]}, {"t": " ", "a": 546, "b": 533, "text": "\t\t\t</div>"}, {"t": " ", "a": 547, "b": 534, "text": "\t\t\t<div class=\"_visual\"><img src=\"https://static.lottedfs.com/contents/images/ckeditor-img/20260306/20260306103122646be73c352d9504bb98cb7e55ae3a42519.webp\" alt=\"\"></div>"}, {"t": " ", "a": 548, "b": 535, "text": "\t\t</div>"}]}, {"lines": [{"t": " ", "a": 551, "b": 538, "text": "\t<div class=\"_evt_nav _info_nav_flex\">"}, {"t": " ", "a": 552, "b": 539, "text": "\t\t<div class=\"_nav_wrap\">"}, {"t": " ", "a": 553, "b": 540, "text": "\t\t\t<div class=\"_nav_inner\">"}, {"t": "+", "a": null, "b": 541, "text": "\t\t\t\t<!-- <div class=\"_nav _nav_1 _current\">", "spans": []}, {"t": "+", "a": null, "b": 542, "text": "\t\t\t\t\t<a href=\"#_evtContent_0\" class=\"_fn_goto\"><span>결제일 할인 혜택</span></a>", "spans": []}, {"t": "+", "a": null, "b": 543, "text": "\t\t\t\t</div> -->", "spans": []}, {"t": " ", "a": 554, "b": 544, "text": "\t\t\t\t<div class=\"_nav _nav_1 _current\">"}, {"t": "-", "a": 555, "b": null, "text": "\t\t\t\t\t<a href=\"#_evtContent_0\" class=\"_fn_goto\"><span>결제일 할인 혜택</span></a>", "spans": []}, {"t": "-", "a": 556, "b": null, "text": "\t\t\t\t</div>", "spans": []}, {"t": "-", "a": 557, "b": null, "text": "\t\t\t\t<div class=\"_nav _nav_1\">", "spans": []}, {"t": " ", "a": 558, "b": 545, "text": "\t\t\t\t\t<a href=\"#_evtContent_1\" class=\"_fn_goto\"><span>결제쿠폰 혜택</span></a>"}, {"t": " ", "a": 559, "b": 546, "text": "\t\t\t\t</div>"}, {"t": " ", "a": 560, "b": 547, "text": "\t\t\t\t<div class=\"_nav _nav_2\">"}]}, {"lines": [{"t": " ", "a": 564, "b": 551, "text": "\t\t</div>"}, {"t": " ", "a": 565, "b": 552, "text": "\t</div>"}, {"t": " ", "a": 566, "b": 553, "text": ""}, {"t": "-", "a": 567, "b": null, "text": "\t<div class=\"_evt_content _evt_content_0\">", "spans": []}, {"t": "+", "a": null, "b": 554, "text": "\t<!-- <div class=\"_evt_content _evt_content_0\">", "spans": [[1, 6]]}, {"t": " ", "a": 568, "b": 555, "text": "\t\t<div class=\"_set_ank\" id=\"_evtContent_0\">&nbsp;</div>"}, {"t": " ", "a": 569, "b": 556, "text": "\t\t<div class=\"_area_wrap\">"}, {"t": " ", "a": 570, "b": 557, "text": "\t\t\t<div class=\"_area_title\">"}, {"t": "-", "a": 571, "b": null, "text": "\t\t\t\t<div class=\"_label\">결제일 할인 혜택</div>", "spans": [[28, 31]]}, {"t": "+", "a": null, "b": 558, "text": "\t\t\t\t<div class=\"_label\">결제일 혜택</div>", "spans": []}, {"t": " ", "a": 572, "b": 559, "text": "\t\t\t\t<div class=\"_sub\">삼성카드 고객 대상</div>"}, {"t": " ", "a": 573, "b": 560, "text": "\t\t\t\t<div class=\"_title\">결제일 할인 혜택</div>"}, {"t": " ", "a": 574, "b": 561, "text": "\t\t\t</div>"}]}, {"lines": [{"t": " ", "a": 600, "b": 587, "text": "\t\t\t\t\t</li>"}, {"t": " ", "a": 601, "b": 588, "text": "\t\t\t\t\t<li>"}, {"t": " ", "a": 602, "b": 589, "text": "\t\t\t\t\t\t<div class=\"_label\">행사기간</div>"}, {"t": "-", "a": 603, "b": null, "text": "\t\t\t\t\t\t<div class=\"_item\">2026.10.5 ~ 2026.10.7</div>", "spans": [[30, 32], [33, 35], [36, 39], [41, 46]]}, {"t": "+", "a": null, "b": 590, "text": "\t\t\t\t\t\t<div class=\"_item\">2026.7.24~7.26</div>", "spans": [[30, 31], [32, 34], [35, 37]]}, {"t": " ", "a": 604, "b": 591, "text": "\t\t\t\t\t</li>"}, {"t": " ", "a": 605, "b": 592, "text": "\t\t\t\t\t<li>"}, {"t": " ", "a": 606, "b": 593, "text": "\t\t\t\t\t\t<div class=\"_label\">행사내용</div>"}]}, {"lines": [{"t": " ", "a": 619, "b": 606, "text": "\t\t\t\t\t<li>결제일 할인이 적용된 결제건 취소 시, 매출취소전표가 <br>삼성카드에 접수"}, {"t": " ", "a": 620, "b": 607, "text": "\t\t\t\t\t\t되어야 할인한도가 복원됨 <br>(당일 결제건은 당일 취소 시 바로 한도 복원)</li>"}, {"t": " ", "a": 621, "b": 608, "text": "\t\t\t\t\t<li>예산 소진 시 조기 종료됩니다.</li>"}, {"t": "-", "a": 622, "b": null, "text": "\t\t\t\t\t<li>행사 기간 동안 1회, 최종 결제금액 기준으로 혜택이<br/> 적용됩니다.</li>", "spans": [[38, 43]]}, {"t": "+", "a": null, "b": 609, "text": "\t\t\t\t\t<li>행사 기간 동안 1회, 최종 결제금액 기준으로 혜택이 적용됩니다.</li>", "spans": []}, {"t": " ", "a": 623, "b": 610, "text": "\t\t\t\t</ul>"}, {"t": " ", "a": 624, "b": 611, "text": "\t\t\t</div>"}, {"t": "-", "a": 625, "b": null, "text": "\t\t\t<!-- <div class=\"_banner_content\">", "spans": [[3, 8]]}, {"t": "+", "a": null, "b": 612, "text": "\t\t\t<div class=\"_banner_content\">", "spans": []}, {"t": " ", "a": 626, "b": 613, "text": "\t\t\t\t<div class=\"_area_wrap\">"}, {"t": " ", "a": 627, "b": 614, "text": "\t\t\t\t\t<div class=\"_item\">"}, {"t": " ", "a": 628, "b": 615, "text": "\t\t\t\t\t\t<a href=\"https://kor.lottedfs.com/kr/event/eventDetail?evtDispNo=1018543\"><img src=\"https://static.lottedfs.com/contents/images/ckeditor-img/20250904/20250904104441053d3274f34a2d44973a9231d91b64cdfa2.jpg\" alt=\"카카오페이 결제 고객 추가 할인 혜택\" /></a>"}, {"t": " ", "a": 629, "b": 616, "text": "\t\t\t\t\t</div>"}, {"t": " ", "a": 630, "b": 617, "text": "\t\t\t\t</div>"}, {"t": "-", "a": 631, "b": null, "text": "\t\t\t</div> -->", "spans": []}, {"t": " ", "a": 632, "b": 618, "text": "\t\t</div>"}, {"t": " ", "a": 633, "b": 619, "text": "\t</div>"}, {"t": "+", "a": null, "b": 620, "text": "\t</div> -->", "spans": []}, {"t": " ", "a": 634, "b": 621, "text": ""}, {"t": " ", "a": 635, "b": 622, "text": "\t<div class=\"_evt_content _evt_content_1\">"}, {"t": " ", "a": 636, "b": 623, "text": "\t\t<div class=\"_set_ank\" id=\"_evtContent_1\">&nbsp;</div>"}]}, {"lines": [{"t": " ", "a": 638, "b": 625, "text": "\t\t\t<div class=\"_area_title\">"}, {"t": " ", "a": 639, "b": 626, "text": "\t\t\t\t<div class=\"_label\">결제쿠폰 혜택</div>"}, {"t": " ", "a": 640, "b": 627, "text": "\t\t\t\t<div class=\"_sub\">삼성카드 결제 고객</div>"}, {"t": "-", "a": 641, "b": null, "text": "\t\t\t\t<div class=\"_title\">최대 10% 즉시 할인</div>", "spans": [[31, 36]]}, {"t": "+", "a": null, "b": 628, "text": "\t\t\t\t<div class=\"_title\">최대 10% 결제쿠폰</div>", "spans": [[31, 35]]}, {"t": " ", "a": 642, "b": 629, "text": "\t\t\t</div>"}, {"t": " ", "a": 643, "b": 630, "text": ""}, {"t": " ", "a": 644, "b": 631, "text": "\t\t\t<!-- <div class=\"_outline\">"}]}, {"lines": [{"t": " ", "a": 874, "b": 861, "text": "\t\t\t\t</div>"}, {"t": " ", "a": 875, "b": 862, "text": "\t\t\t</div>"}, {"t": " ", "a": 876, "b": 863, "text": ""}, {"t": "+", "a": null, "b": 864, "text": "", "spans": []}, {"t": "+", "a": null, "b": 865, "text": "", "spans": []}, {"t": " ", "a": 877, "b": 866, "text": "\t\t\t<div class=\"_evt_caution\">"}, {"t": " ", "a": 878, "b": 867, "text": "\t\t\t\t<dl>"}, {"t": " ", "a": 879, "b": 868, "text": "\t\t\t\t\t<dt>삼성카드 유의사항</dt>"}]}, {"lines": [{"t": " ", "a": 886, "b": 875, "text": "\t\t\t\t\t\t\t<li class=\"_noti\">상환 능력에 비해 신용카드 사용액이 과도할 경우 귀하의 개인신용평점이 하락할 수 있습니다.</li>"}, {"t": " ", "a": 887, "b": 876, "text": "\t\t\t\t\t\t\t<li class=\"_noti\">개인신용평점 하락 시 금융거래 관련된 불이익이 발생할 수 있습니다.</li>"}, {"t": " ", "a": 888, "b": 877, "text": "\t\t\t\t\t\t\t<li class=\"_noti\">일정기간 원리금을 연체할 경우, 모든 원리금을 변제할 의무가 발생할 수 있습니다.</li>"}, {"t": "-", "a": 889, "b": null, "text": "\t\t\t\t\t\t\t<li class=\"_emp\"><b>준법 심의필 I3181-26-1063<br>( 2026.03.05 ~ 2027.03.04 )</b></li>", "spans": []}, {"t": "+", "a": null, "b": 878, "text": "\t\t\t\t\t\t\t<li class=\"_emp\"><b>준법 심의필 I3181-26-1063<br>( 2026.03.05 ~ 2027.03.04 )</br></li>", "spans": [[81, 82]]}, {"t": " ", "a": 890, "b": 879, "text": "\t\t\t\t\t\t</ul>"}, {"t": " ", "a": 891, "b": 880, "text": "\t\t\t\t\t</dd>"}, {"t": " ", "a": 892, "b": 881, "text": "\t\t\t\t</dl>"}]}, {"lines": [{"t": " ", "a": 940, "b": 929, "text": "\t\t\t</div>"}, {"t": " ", "a": 941, "b": 930, "text": "\t\t\t<div class=\"_caution\">"}, {"t": " ", "a": 942, "b": 931, "text": "\t\t\t\t<ul>"}, {"t": "-", "a": 943, "b": null, "text": "\t\t\t\t\t<li>카드사 정책에 따라 월중 업종 무이자/다이어트할부 미제공 <br>", "spans": [[29, 36]]}, {"t": "-", "a": 944, "b": null, "text": "\t\t\t\t\t\t변경 시 무이자/다이어트할부 적용이 되지 않을 수 있습니다.</li>", "spans": []}, {"t": "-", "a": 945, "b": null, "text": "\t\t\t\t\t<li>무이자/다이어트 할부 혜택은 5만원 이상 결제 시 사용 가능 <br>합니다.</li>", "spans": []}, {"t": "+", "a": null, "b": 932, "text": "\t\t\t\t\t<li>카드사 정책에 따라 월중 업종 무이자 미제공 변경 시<br>무이자 적용이 되지 않을 수 있습니다.</li>", "spans": [[34, 38], [42, 68]]}, {"t": "+", "a": null, "b": 933, "text": "\t\t\t\t\t<li>무이자 할부 혜택은 5만원 이상 결제 시 사용 가능합니다.</li>", "spans": []}, {"t": " ", "a": 946, "b": 934, "text": "\t\t\t\t</ul>"}, {"t": "-", "a": 947, "b": null, "text": "\t\t\t</div>", "spans": []}, {"t": "-", "a": 948, "b": null, "text": "\t\t\t<div class=\"_caution _type2\">", "spans": []}, {"t": "-", "a": 949, "b": null, "text": "\t\t\t\t<div class=\"_caution_tit\">삼성카드 유의사항</div>", "spans": []}, {"t": "-", "a": 950, "b": null, "text": "\t\t\t\t<ul>", "spans": []}, {"t": "-", "a": 951, "b": null, "text": "\t\t\t\t\t<li>결제 금액은 쿠폰 할인 등을 적용한 최종 결제 금액으로 <br> 산정합니다.</li>", "spans": []}, {"t": "-", "a": 952, "b": null, "text": "\t\t\t\t\t<li>결제일 할인은 20만원 이상 최초 결제 건에 한하여 1회 적용<br>됩니다. (최대 10만원 한도)</li>", "spans": []}, {"t": "-", "a": 953, "b": null, "text": "\t\t\t\t\t<li class=\"_bold _pl\">결제일 할인이 적용된 결제건 취소 시, 매출취소전표가 삼성<br>카드에 접수되어야 할인한도가 복원됩니다.(당일 결제건은 <br>당일 취소 시 바로 한도 복원)</li>", "spans": []}, {"t": "-", "a": 954, "b": null, "text": "\t\t\t\t\t<li>본 이벤트는 [국내신용카드>삼성카드]로 결제 시 참여 <br>가능하며 간편결제<br>", "spans": []}, {"t": "-", "a": 955, "b": null, "text": "\t\t\t\t\t\t(네이버페이, 카카오페이, 토스페이 등) <br>결제 시 대상에서 제외됩니다.", "spans": []}, {"t": "-", "a": 956, "b": null, "text": "\t\t\t\t\t</li>", "spans": []}, {"t": "-", "a": 957, "b": null, "text": "\t\t\t\t\t<li>결제일 할인 적용 기준은 1회 결제금액 (승인금액) <br>기준입니다. (영수증 합산 불가)", "spans": []}, {"t": "-", "a": 958, "b": null, "text": "\t\t\t\t\t</li>", "spans": []}, {"t": "-", "a": 959, "b": null, "text": "\t\t\t\t\t<li>결제일 할인 금액은 카드 결제대금에서 자동 차감됩니다.</li>", "spans": []}, {"t": "-", "a": 960, "b": null, "text": "\t\t\t\t\t<li>삼성카드의 다른 할인 혜택과 중복 적용되지 않으며, 혜택이 <br>큰 금액으로", "spans": []}, {"t": "-", "a": 961, "b": null, "text": "\t\t\t\t\t\t적용됩니다.</li>", "spans": []}, {"t": "-", "a": 962, "b": null, "text": "\t\t\t\t\t<li>결제일 할인은 무이자/다이어트할부 혜택과 중복 적용 <br>됩니다.</li>", "spans": []}, {"t": "-", "a": 963, "b": null, "text": "\t\t\t\t\t<li>결제일 할인 적용 시 포인트 및 마일리지는 적립되지<br> 않습니다.</li>", "spans": []}, {"t": "-", "a": 964, "b": null, "text": "\t\t\t\t\t<li>카드사 및 제휴사의 사정으로 사전 안내 없이 변경/중단될 <br>수 있습니다.</li>", "spans": []}, {"t": "-", "a": 965, "b": null, "text": "\t\t\t\t\t<li>온누리상품권/정부 지원금/국민행복 삼성카드 국가바우처 <br>사용 건은 결제일 할인에서 제외됩니다.</li>", "spans": []}, {"t": "-", "a": 966, "b": null, "text": "", "spans": []}, {"t": "-", "a": 967, "b": null, "text": "\t\t\t\t\t<li class=\"_bold _deco\"><span class=\"_mark\">※</span> 연체이자율 : 회원별/이용상품별 정상이자율 + 3%p <br> (최고 연 20.0%)</li>", "spans": []}, {"t": "-", "a": 968, "b": null, "text": "\t\t\t\t\t<li class=\"_bold _deco\">* 연체 발생 시점에 정상이자율이 없는 경우 아래와 같이 <br> 적용</li>", "spans": []}, {"t": "-", "a": 969, "b": null, "text": "\t\t\t\t\t<li class=\"_bold _deco _margin\">① 일시불 거래 연체 시 : 거래 발생 시점의 최소 기간<br>(2개월) 유이자할부 이자율</li>", "spans": []}, {"t": "-", "a": 970, "b": null, "text": "\t\t\t\t\t<li class=\"_bold _deco _margin\">② 무이자할부 거래 연체 시 : 거래 발생 시점의 동일한 <br> 할부 계약기간유이자할부</li>", "spans": []}, {"t": "-", "a": 971, "b": null, "text": "\t\t\t\t\t<li class=\"_deco\"><span class=\"_mark\">※</span> 금융상품 이용 전 상품설명서, 홈페이지, 약관 통해 이용 <br>조건 확인</li>", "spans": []}, {"t": "-", "a": 972, "b": null, "text": "\t\t\t\t\t<li class=\"_deco\"><span class=\"_mark\">※</span> 금융소비자는 금융소비자보호법 제 19조 제1항에 따라 <br>해당 상품 또는 서비스에 대하여 설명을 받을 권리가 있음</li>", "spans": []}, {"t": "-", "a": 973, "b": null, "text": "\t\t\t\t\t<li class=\"_deco\"><span class=\"_mark\">※</span> 신용카드 발급이 부적정한 경우(개인신용평점 낮음 등) <br>카드 발급이 제한될 수 있음</li>", "spans": []}, {"t": "-", "a": 974, "b": null, "text": "\t\t\t\t\t<li class=\"_deco\"><span class=\"_mark\">※</span> 카드 이용대금과 이에 수반되는 모든 수수료를 지정된 <br>대금 결제일에 상환</li>", "spans": []}, {"t": "-", "a": 975, "b": null, "text": "\t\t\t\t\t<li class=\"_bold _deco\"><span class=\"_mark\">※</span> 상환 능력에 비해 신용카드 사용액이 과도할 경우 귀하의 <br>개인신용평점이 하락할 수 있음</li>", "spans": []}, {"t": "-", "a": 976, "b": null, "text": "\t\t\t\t\t<li class=\"_bold _deco\"><span class=\"_mark\">※</span> 개인신용평점 하락 시 금융거래 관련된 불이익이 발생할 <br>수 있음</li>", "spans": []}, {"t": "-", "a": 977, "b": null, "text": "\t\t\t\t\t<li class=\"_bold _deco\"><span class=\"_mark\">※</span> 일정 기간 원리금을 연체할 경우, 모든 원리금을 변제할 <br>의무가 발생할 수 있음</li>", "spans": []}, {"t": "-", "a": 978, "b": null, "text": "\t\t\t\t</ul>", "spans": []}, {"t": "-", "a": 979, "b": null, "text": "\t\t\t\t<div class=\"_caution_desc\"><b>삼성카드 준법심의필 I3181-26-2827<br>( 2026.06.01 ~ 2027.05.31 )</b></div>", "spans": []}, {"t": " ", "a": 980, "b": 935, "text": "\t\t\t</div>"}, {"t": " ", "a": 981, "b": 936, "text": "\t\t</div>"}, {"t": " ", "a": 982, "b": 937, "text": "\t</div>"}]}], "added": 17, "removed": 62, "same": false, "places": [], "normalized": false}