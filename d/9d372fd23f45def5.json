s.com/contents/images/ckeditor-img/20261001/202610011402063522f6b3f6137e340a9a5b0605daeca07f3.webp\" alt=\"\"></div>", "spans": []}, {"t": "+", "a": null, "b": 189, "text": "\t\t\t\t<div class=\"_contents_desc\">", "spans": []}, {"t": "+", "a": null, "b": 190, "text": "\t\t\t\t\t여행지에서도 평소의 루틴을 이어가는 분들이 많습니다. 이번 여행에서는 러닝으로 이른 아침의 문을 열어보세요.<br>", "spans": []}, {"t": "+", "a": null, "b": 191, "text": "\t\t\t\t\t전날에는 볼 수 없던 새로운 도시의 모습을 즐길 수 있는 것은 물론, 활기찬 하루를 시작할 수 있답니다.", "spans": []}, {"t": "+", "a": null, "b": 192, "text": "\t\t\t\t</div>", "spans": []}, {"t": "+", "a": null, "b": 193, "text": "\t\t\t</div>", "spans": []}, {"t": "+", "a": null, "b": 194, "text": "\t\t</div>", "spans": []}, {"t": "+", "a": null, "b": 195, "text": "\t</div>", "spans": []}, {"t": "+", "a": null, "b": 196, "text": "", "spans": []}, {"t": "+", "a": null, "b": 197, "text": "\t<div class=\"_nav_content _nav_content_2 _set_ank\" id=\"_evtContent_2\">", "spans": []}, {"t": "+", "a": null, "b": 198, "text": "\t\t<div class=\"_nav_content_wrap\">", "spans": []}, {"t": "+", "a": null, "b": 199, "text": "\t\t\t<div class=\"_content_header\">", "spans": []}, {"t": "+", "a": null, "b": 200, "text": "\t\t\t\t<span class=\"_desc\">단풍을 따라 걷는 하루</span>", "spans": []}, {"t": "+", "a": null, "b": 201, "text": "\t\t\t\t<span class=\"_tit\">HIKING</span>", "spans": []}, {"t": "+", "a": null, "b": 202, "text": "\t\t\t\t<span class=\"_hash\">", "spans": []}, {"t": "+", "a": null, "b": 203, "text": "\t\t\t\t\t<em>설악산</em>", "spans": []}, {"t": "+", "a": null, "b": 204, "text": "\t\t\t\t\t<em>교토</em>", "spans": []}, {"t": "+", "a": null, "b": 205, "text": "\t\t\t\t\t<em>퀘벡</em>", "spans": []}, {"t": "+", "a": null, "b": 206, "text": "\t\t\t\t</span>", "spans": []}, {"t": "+", "a": null, "b": 207, "text": "\t\t\t</div>", "spans": []}, {"t": "+", "a": null, "b": 208, "text": "", "spans": []}, {"t": "+", "a": null, "b": 209, "text": "\t\t\t<div class=\"_content_area\">", "spans": []}, {"t": "+", "a": null, "b": 210, "text": "\t\t\t\t<div class=\"_content_visual\"><img src=\"https://static.lottedfs.com/contents/images/ckeditor-img/20261001/20261001141544029f21afaa462f346739ce97717fa8df24f.webp\" alt=\"\"></div>", "spans": []}, {"t": "+", "a": null, "b": 211, "text": "\t\t\t\t<div class=\"_contents_desc\">", "spans": []}, {"t": "+", "a": null, "b": 212, "text": "\t\t\t\t\t‘단풍’은 오직 이 계절에만 즐길 수 있는 호사입니다. 붉게 물든 나무 길을 따라 걸으며 아름다움에 취해보세요.<br>", "spans": []}, {"t": "+", "a": null, "b": 213, "text": "\t\t\t\t\t이때 얇은 아우터를 여러 겹 겹쳐 입으면 좋습니다. 산 아래와 중턱의 높은 일교차를 현명하게 극복할 수 있는 방법이죠.", "spans": []}, {"t": "+", "a": null, "b": 214, "text": "\t\t\t\t</div>", "spans": []}, {"t": "+", "a": null, "b": 215, "text": "\t\t\t</div>", "spans": []}, {"t": "+", "a": null, "b": 216, "text": "\t\t</div>", "spans": []}, {"t": "+", "a": null, "b": 217, "text": "\t</div>", "spans": []}, {"t": "+", "a": null, "b": 218, "text": "", "spans": []}, {"t": "+", "a": null, "b": 219, "text": "\t<div class=\"_nav_content _nav_content_3 _set_ank\" id=\"_evtContent_3\">", "spans": []}, {"t": "+", "a": null, "b": 220, "text": "\t\t<div class=\"_nav_content_wrap\">", "spans": []}, {"t": "+", "a": null, "b": 221, "text": "\t\t\t<div class=\"_content_header\">", "spans": []}, {"t": "+", "a": null, "b": 222, "text": "\t\t\t\t<span class=\"_desc\">자연 속 즐기는 웰니스</span>", "spans": []}, {"t": "+", "a": null, "b": 223, "text": "\t\t\t\t<span class=\"_tit\">YOGA</span>", "spans": []}, {"t": "+", "a": null, "b": 224, "text": "\t\t\t\t<span class=\"_hash\">", "spans": []}, {"t": "+", "a": null, "b": 225, "text": "\t\t\t\t\t<em>발리</em>", "spans": []}, {"t": "+", "a": null, "b": 226, "text": "\t\t\t\t\t<em>푸켓</em>", "spans": []}, {"t": "+", "a": null, "b": 227, "text": "\t\t\t\t\t<em>하와이</em>", "spans": []}, {"t": "+", "a": null, "b": 228, "text": "\t\t\t\t</span>", "spans": []}, {"t": "+", "a": null, "b": 229, "text": "\t\t\t</div>", "spans": []}, {"t": "+", "a": null, "b": 230, "text": "", "spans": []}, {"t": "+", "a": null, "b": 231, "text": "\t\t\t<div class=\"_content_area\">", "spans": []}, {"t": "+", "a": null, "b": 232, "text": "\t\t\t\t<div class=\"_content_visual\"><img src=\"https://static.lottedfs.com/contents/images/ckeditor-img/20261001/20261001141657476ee395ba36ff0427db2d61dafd3c09704.webp\" alt=\"\"></div>", "spans": []}, {"t": "+", "a": null, "b": 233, "text": "\t\t\t\t<div class=\"_contents_desc\">", "spans": []}, {"t": "+", "a": null, "b": 234, "text": "\t\t\t\t\t푸른 자연 속 몸과 마음을 수련할 수 있는 요가는 어떨까요?<br>", "spans": []}, {"t": "+", "a": null, "b": 235, "text": "\t\t\t\t\t나 아닌 다른 생명의 존재를 느끼며 깊게 숨 쉬는 경험은 최고의 힐링을 선사합니다. 꼭 전문가가 아니라도 좋아요.<br>", "spans": []}, {"t": "+", "a": null, "b": 236, "text": "\t\t\t\t\t강아지와 함께 교감하는 퍼피 요가 프로그램은 ‘천국을 다녀왔다’라는 후기가 난무하죠.<br>", "spans": []}, {"t": "+", "a": null, "b": 237, "text": "\t\t\t\t\t작은 도마뱀의 출현도 귀엽게 느껴지는 동남아 요가 클래스에 몸을 맡겨보세요.", "spans": []}, {"t": "+", "a": null, "b": 238, "text": "\t\t\t\t</div>", "spans": []}, {"t": "+", "a": null, "b": 239, "text": "\t\t\t</div>", "spans": []}, {"t": "+", "a": null, "b": 240, "text": "\t\t</div>", "spans": []}, {"t": "+", "a": null, "b": 241, "text": "\t</div>", "spans": []}, {"t": "+", "a": null, "b": 242, "text": "", "spans": []}, {"t": "+", "a": null, "b": 243, "text": "\t<div class=\"_nav_content _nav_content_4 _set_ank\" id=\"_evtContent_4\">", "spans": []}, {"t": "+", "a": null, "b": 244, "text": "\t\t<div class=\"_nav_content_wrap\">", "spans": []}, {"t": "+", "a": null, "b": 245, "text": "\t\t\t<div class=\"_content_header\">", "spans": []}, {"t": "+", "a": null, "b": 246, "text": "\t\t\t\t<span class=\"_desc\">선선한 바람과 필드</span>", "spans": []}, {"t": "+", "a": null, "b": 247, "text": "\t\t\t\t<span class=\"_tit\">GOLF</span>", "spans": []}, {"t": "+", "a": null, "b": 248, "text": "\t\t\t\t<span class=\"_hash\">", "spans": []}, {"t": "+", "a": null, "b": 249, "text": "\t\t\t\t\t<em>가고시마</em>", "spans": []}, {"t": "+", "a": null, "b": 250, "text": "\t\t\t\t\t<em>방콕</em>", "spans": []}, {"t": "+", "a": null, "b": 251, "text": "\t\t\t\t\t<em>나트랑</em>", "spans": []}, {"t": "+", "a": null, "b": 252, "text": "\t\t\t\t</span>", "spans": []}, {"t": "+", "a": null, "b": 253, "text": "\t\t\t</div>", "spans": []}, {"t": "+", "a": null, "b": 254, "text": "", "spans": []}, {"t": "+", "a": null, "b": 255, "text": "\t\t\t<div class=\"_content_area\">", "spans": []}, {"t": "+", "a": null, "b": 256, "text": "\t\t\t\t<div class=\"_content_visual\"><img src=\"https://static.lottedfs.com/contents/images/ckeditor-img/20261001/20261001141708096fb4417ce19014121975c518f0f26c132.webp\" alt=\"\"></div>", "spans": []}, {"t": "+", "a": null, "b": 257, "text": "\t\t\t\t<div class=\"_contents_desc\">", "spans": []}, {"t": "+", "a": null, "b": 258, "text": "\t\t\t\t\t골프 치기 참 좋은 날씨. 특히 동남아는 우기가 끝나 쾌적한 날씨가 반겨줍니다.<br>", "spans": []}, {"t": "+", "a": null, "b": 259, "text": "\t\t\t\t\t골프와 리조트 휴식을 함께 즐길 수 있어 매력적이죠.<br>", "spans": []}, {"t": "+", "a": null, "b": 260, "text": "\t\t\t\t\t선선한 날씨인 만큼 오전엔 춥고 낮엔 더울 수 있으니 바람막이 점퍼와 넥 워머를 갖춰 체온을 유지하세요. ", "spans": []}, {"t": "+", "a": null, "b": 261, "text": "\t\t\t\t</div>", "spans": []}, {"t": "+", "a": null, "b": 262, "text": "\t\t\t</div>", "spans": []}, {"t": "+", "a": null, "b": 263, "text": "\t\t</div>", "spans": []}, {"t": "+", "a": null, "b": 264, "text": "\t</div>", "spans": []}, {"t": "+", "a": null, "b": 265, "text": "", "spans": []}, {"t": "+", "a": null, "b": 266, "text": "</div>", "spans": []}]}], "added": 266, "removed": 0, "same": false, "places": [], "normalized": false}