mages/ckeditor-img/20260306/20260306103112535868efc2aaa9242f99bd8ba2aa625eb31.webp\" alt=\"\"></div>"}, {"t": " ", "a": 294, "b": 293, "text": "\t\t</div>"}]}, {"lines": [{"t": " ", "a": 330, "b": 329, "text": "\t\t\t\t\t<dl>"}, {"t": " ", "a": 331, "b": 330, "text": "\t\t\t\t\t\t<dt>할인율</dt>"}, {"t": " ", "a": 332, "b": 331, "text": "\t\t\t\t\t\t<dd>"}, {"t": "-", "a": 333, "b": null, "text": "\t\t\t\t\t\t\t<span>8% (최대 8만원)</span>", "spans": [[13, 14], [20, 21]]}, {"t": "+", "a": null, "b": 332, "text": "\t\t\t\t\t\t\t<span>10% (최대 10만원)</span>", "spans": [[13, 15], [21, 23]]}, {"t": " ", "a": 334, "b": 333, "text": "\t\t\t\t\t\t</dd>"}, {"t": " ", "a": 335, "b": 334, "text": "\t\t\t\t\t</dl>"}, {"t": " ", "a": 336, "b": 335, "text": "\t\t\t\t</div>"}]}, {"lines": [{"t": " ", "a": 345, "b": 344, "text": "\t\t\t\t\t</li>"}, {"t": " ", "a": 346, "b": 345, "text": "\t\t\t\t\t<li>"}, {"t": " ", "a": 347, "b": 346, "text": "\t\t\t\t\t\t<div class=\"_label\">행사기간</div>"}, {"t": "-", "a": 348, "b": null, "text": "\t\t\t\t\t\t<div class=\"_item\">2026.9.18~9.22</div>", "spans": [[30, 31], [33, 36], [37, 39]]}, {"t": "+", "a": null, "b": 347, "text": "\t\t\t\t\t\t<div class=\"_item\">2026.10.5 ~ 2026.10.7</div>", "spans": [[30, 41], [43, 44], [45, 46]]}, {"t": " ", "a": 349, "b": 348, "text": "\t\t\t\t\t</li>"}, {"t": " ", "a": 350, "b": 349, "text": "\t\t\t\t\t<li>"}, {"t": " ", "a": 351, "b": 350, "text": "\t\t\t\t\t\t<div class=\"_label\">행사내용</div>"}, {"t": " ", "a": 352, "b": 351, "text": "\t\t\t\t\t\t<div class=\"_item\">"}, {"t": "-", "a": 353, "b": null, "text": "\t\t\t\t\t\t\t삼성 개인신용카드 결제 고객 20만원 이상 결제 시 8% 결제일 할인<br>(최대 8만원)", "spans": [[36, 37], [53, 54]]}, {"t": "+", "a": null, "b": 352, "text": "\t\t\t\t\t\t\t삼성 개인신용카드 결제 고객 20만원 이상 결제 시 10% 결제일 할인<br>(최대 10만원)", "spans": [[36, 38], [54, 56]]}, {"t": " ", "a": 354, "b": 353, "text": "\t\t\t\t\t\t\t<div class=\"_em\"><em>기간 내 1회</em></div>"}, {"t": " ", "a": 355, "b": 354, "text": "\t\t\t\t\t\t</div>"}, {"t": " ", "a": 356, "b": 355, "text": "\t\t\t\t\t</li>"}]}, {"lines": [{"t": " ", "a": 513, "b": 512, "text": "\t\t\t\t\t\t\t<span class=\"_txt\">행사기간</span>"}, {"t": " ", "a": 514, "b": 513, "text": "\t\t\t\t\t\t</div>"}, {"t": " ", "a": 515, "b": 514, "text": "\t\t\t\t\t\t<div class=\"_val\">"}, {"t": "-", "a": 516, "b": null, "text": "\t\t\t\t\t\t\t<span class=\"_txt\">2026.9.11~9.25</span>", "spans": [[31, 32], [35, 37]]}, {"t": "+", "a": null, "b": 515, "text": "\t\t\t\t\t\t\t<span class=\"_txt\">2026.10.1 ~ 10.25</span>", "spans": [[31, 33], [35, 38], [39, 40]]}, {"t": " ", "a": 517, "b": 516, "text": "\t\t\t\t\t\t</div>"}, {"t": " ", "a": 518, "b": 517, "text": "\t\t\t\t\t</li>"}, {"t": " ", "a": 519, "b": 518, "text": "\t\t\t\t\t<li>"}]}, {"lines": [{"t": " ", "a": 666, "b": 665, "text": "\t\t\t\t<ul>"}, {"t": " ", "a": 667, "b": 666, "text": "\t\t\t\t\t<li>"}, {"t": " ", "a": 668, "b": 667, "text": "\t\t\t\t\t\t<div class=\"_label\">행사기간</div>"}, {"t": "-", "a": 669, "b": null, "text": "\t\t\t\t\t\t<div class=\"_item\">2026.9.1~9.30</div>", "spans": [[30, 31], [34, 35], [37, 38]]}, {"t": "+", "a": null, "b": 668, "text": "\t\t\t\t\t\t<div class=\"_item\">2026.10.1 ~ 10.31</div>", "spans": [[30, 32], [34, 35], [36, 39], [41, 42]]}, {"t": " ", "a": 670, "b": 669, "text": "\t\t\t\t\t</li>"}, {"t": " ", "a": 671, "b": 670, "text": "\t\t\t\t\t<li>"}, {"t": " ", "a": 672, "b": 671, "text": "\t\t\t\t\t\t<div class=\"_label\">행사대상</div>"}]}, {"lines": [{"t": " ", "a": 686, "b": 685, "text": "\t\t\t\t<div class=\"_caution_tit\">삼성카드 유의사항</div>"}, {"t": " ", "a": 687, "b": 686, "text": "\t\t\t\t<ul>"}, {"t": " ", "a": 688, "b": 687, "text": "\t\t\t\t\t<li>결제 금액은 쿠폰 할인 등을 적용한 최종 결제 금액으로 산정합니다.</li>"}, {"t": "-", "a": 689, "b": null, "text": "\t\t\t\t\t<li>결제일 할인은 20만원 이상 최초 결제 건에 한하여 1회 적용됩니다.<br>(최대 8만원 한도)</li>", "spans": [[55, 56]]}, {"t": "+", "a": null, "b": 688, "text": "\t\t\t\t\t<li>결제일 할인은 20만원 이상 최초 결제 건에 한하여 1회 적용됩니다.<br>(최대 10만원 한도)</li>", "spans": [[55, 57]]}, {"t": " ", "a": 690, "b": 689, "text": "\t\t\t\t\t<li class=\"_bold _pl\">결제일 할인이 적용된 결제건 취소 시, 매출취소전표가 삼성카드에 접수 <br>"}, {"t": " ", "a": 691, "b": 690, "text": "\t\t\t\t\t\t되어야 할인한도가 복원됩니다.(당일 결제건은 당일 취소 시 바로 한도 복원)</li>"}, {"t": " ", "a": 692, "b": 691, "text": "\t\t\t\t\t<li>본 이벤트는 [국내신용카드>삼성카드]로 결제 시 참여 가능하며 간편결제<br>"}]}], "added": 8, "removed": 9, "same": false, "places": [], "normalized": false}