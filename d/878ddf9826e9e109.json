0, 32], [33, 34], [37, 39], [41, 46]]}, {"t": "+", "a": null, "b": 332, "text": "\t\t\t\t\t\t<div class=\"_item\">2026.7.24 ~ 7.26</div>", "spans": [[30, 31], [32, 34], [37, 39]]}, {"t": " ", "a": 348, "b": 333, "text": "\t\t\t\t\t</li>"}, {"t": " ", "a": 349, "b": 334, "text": "\t\t\t\t\t<li>"}, {"t": " ", "a": 350, "b": 335, "text": "\t\t\t\t\t\t<div class=\"_label\">행사내용</div>"}]}, {"lines": [{"t": " ", "a": 366, "b": 351, "text": "\t\t\t\t\t<li>행사 기간 동안 1회, 최종 결제금액 기준으로 혜택이 적용됩니다.</li>"}, {"t": " ", "a": 367, "b": 352, "text": "\t\t\t\t</ul>"}, {"t": " ", "a": 368, "b": 353, "text": "\t\t\t</div>"}, {"t": "-", "a": 369, "b": null, "text": "\t\t\t<!-- <div class=\"_banner_content\">", "spans": [[3, 8]]}, {"t": "+", "a": null, "b": 354, "text": "\t\t\t<div class=\"_banner_content\">", "spans": []}, {"t": " ", "a": 370, "b": 355, "text": "\t\t\t\t<div class=\"_area_wrap\">"}, {"t": " ", "a": 371, "b": 356, "text": "\t\t\t\t\t<div class=\"_item\">"}, {"t": " ", "a": 372, "b": 357, "text": "\t\t\t\t\t\t<a href=\"https://kor.lottedfs.com/kr/event/eventDetail?evtDispNo=1018543\"><img src=\"https://static.lottedfs.com/contents/images/ckeditor-img/20250904/20250904104441053d3274f34a2d44973a9231d91b64cdfa2.jpg\" alt=\"카카오페이 결제 고객 추가 할인 혜택\" /></a>"}, {"t": " ", "a": 373, "b": 358, "text": "\t\t\t\t\t</div>"}, {"t": " ", "a": 374, "b": 359, "text": "\t\t\t\t</div>"}, {"t": "-", "a": 375, "b": null, "text": "\t\t\t</div> -->", "spans": []}, {"t": " ", "a": 376, "b": 360, "text": "\t\t</div>"}, {"t": " ", "a": 377, "b": 361, "text": "\t</div>"}, {"t": "+", "a": null, "b": 362, "text": "\t</div> -->", "spans": []}, {"t": " ", "a": 378, "b": 363, "text": ""}, {"t": " ", "a": 379, "b": 364, "text": "\t<div class=\"_evt_content _evt_content_1\">"}, {"t": " ", "a": 380, "b": 365, "text": "\t\t<div class=\"_set_ank\" id=\"_evtContent_1\">&nbsp;</div>"}]}, {"lines": [{"t": " ", "a": 382, "b": 367, "text": "\t\t\t<div class=\"_area_title\">"}, {"t": " ", "a": 383, "b": 368, "text": "\t\t\t\t<div class=\"_label\">결제쿠폰 혜택</div>"}, {"t": " ", "a": 384, "b": 369, "text": "\t\t\t\t<div class=\"_sub\">삼성카드 결제 고객</div>"}, {"t": "-", "a": 385, "b": null, "text": "\t\t\t\t<div class=\"_title\">최대 10% 결제쿠폰 증정</div>", "spans": [[35, 38]]}, {"t": "+", "a": null, "b": 370, "text": "\t\t\t\t<div class=\"_title\">최대 10% 결제쿠폰</div>", "spans": []}, {"t": " ", "a": 386, "b": 371, "text": "\t\t\t</div>"}, {"t": " ", "a": 387, "b": 372, "text": ""}, {"t": " ", "a": 388, "b": 373, "text": "\t\t\t<div class=\"_area_box\">"}]}, {"lines": [{"t": " ", "a": 677, "b": 662, "text": "\t\t\t</div>"}, {"t": " ", "a": 678, "b": 663, "text": "\t\t\t<div class=\"_caution\">"}, {"t": " ", "a": 679, "b": 664, "text": "\t\t\t\t<ul>"}, {"t": "-", "a": 680, "b": null, "text": "\t\t\t\t\t<li>카드사 정책에 따라 월중 업종 무이자/다이어트할부 미제공 변경 시 <br>무이자/다이어트할부 적용이 되지 않을 수 있습니다.</li>", "spans": [[29, 36], [46, 50], [53, 60], [67, 68]]}, {"t": "-", "a": 681, "b": null, "text": "\t\t\t\t\t<li>무이자/다이어트 할부 혜택은 5만원 이상 결제 시 사용 가능합니다.</li>", "spans": [[12, 17]]}, {"t": "+", "a": null, "b": 665, "text": "\t\t\t\t\t<li>카드사 정책에 따라 월중 업종 무이자 미제공 변경 시 무이자 적용이 되지<br>않을 수 있습니다.</li>", "spans": [[49, 53]]}, {"t": "+", "a": null, "b": 666, "text": "\t\t\t\t\t<li>무이자 할부 혜택은 5만원 이상 결제 시 사용 가능합니다.</li>", "spans": []}, {"t": " ", "a": 682, "b": 667, "text": "\t\t\t\t</ul>"}, {"t": "-", "a": 683, "b": null, "text": "\t\t\t</div>", "spans": []}, {"t": "-", "a": 684, "b": null, "text": "\t\t\t<div class=\"_caution _type2\">", "spans": []}, {"t": "-", "a": 685, "b": null, "text": "\t\t\t\t<div class=\"_caution_tit\">삼성카드 유의사항</div>", "spans": []}, {"t": "-", "a": 686, "b": null, "text": "\t\t\t\t<ul>", "spans": []}, {"t": "-", "a": 687, "b": null, "text": "\t\t\t\t\t<li>결제 금액은 쿠폰 할인 등을 적용한 최종 결제 금액으로 산정합니다.</li>", "spans": []}, {"t": "-", "a": 688, "b": null, "text": "\t\t\t\t\t<li>결제일 할인은 20만원 이상 최초 결제 건에 한하여 1회 적용됩니다.<br>(최대 10만원 한도)</li>", "spans": []}, {"t": "-", "a": 689, "b": null, "text": "\t\t\t\t\t<li class=\"_bold _pl\">결제일 할인이 적용된 결제건 취소 시, 매출취소전표가 삼성카드에 접수 <br>", "spans": []}, {"t": "-", "a": 690, "b": null, "text": "\t\t\t\t\t\t되어야 할인한도가 복원됩니다.(당일 결제건은 당일 취소 시 바로 한도 복원)</li>", "spans": []}, {"t": "-", "a": 691, "b": null, "text": "\t\t\t\t\t<li>본 이벤트는 [국내신용카드>삼성카드]로 결제 시 참여 가능하며 간편결제<br>", "spans": []}, {"t": "-", "a": 692, "b": null, "text": "\t\t\t\t\t\t(네이버페이, 카카오페이, 토스페이 등) 결제 시 대상에서 제외됩니다.", "spans": []}, {"t": "-", "a": 693, "b": null, "text": "\t\t\t\t\t</li>", "spans": []}, {"t": "-", "a": 694, "b": null, "text": "\t\t\t\t\t<li>결제일 할인 적용 기준은 1회 결제금액 (승인금액) 기준입니다. <br>", "spans": []}, {"t": "-", "a": 695, "b": null, "text": "\t\t\t\t\t\t(영수증 합산 불가)", "spans": []}, {"t": "-", "a": 696, "b": null, "text": "\t\t\t\t\t</li>", "spans": []}, {"t": "-", "a": 697, "b": null, "text": "\t\t\t\t\t<li>결제일 할인 금액은 카드 결제대금에서 자동 차감됩니다.</li>", "spans": []}, {"t": "-", "a": 698, "b": null, "text": "\t\t\t\t\t<li>삼성카드의 다른 할인 혜택과 중복 적용되지 않으며, 혜택이 큰 금액으로<br>", "spans": []}, {"t": "-", "a": 699, "b": null, "text": "\t\t\t\t\t\t적용됩니다.</li>", "spans": []}, {"t": "-", "a": 700, "b": null, "text": "\t\t\t\t\t<li>결제일 할인은 무이자/다이어트할부 혜택과 중복 적용됩니다.</li>", "spans": []}, {"t": "-", "a": 701, "b": null, "text": "\t\t\t\t\t<li>결제일 할인 적용 시 포인트 및 마일리지는 적립되지 않습니다.</li>", "spans": []}, {"t": "-", "a": 702, "b": null, "text": "\t\t\t\t\t<li>카드사 및 제휴사의 사정으로 사전 안내 없이 변경/중단될 수 있습니다.</li>", "spans": []}, {"t": "-", "a": 703, "b": null, "text": "\t\t\t\t\t<li>온누리상품권/정부 지원금/국민행복 삼성카드 국가바우처 사용 건은 결제일<br>", "spans": []}, {"t": "-", "a": 704, "b": null, "text": "\t\t\t\t\t\t할인에서 제외됩니다.</li>", "spans": []}, {"t": "-", "a": 705, "b": null, "text": "", "spans": []}, {"t": "-", "a": 706, "b": null, "text": "\t\t\t\t\t<li class=\"_bold _deco\"><span class=\"_mark\">※</span>연체이자율 : 회원별/이용상품별 정상이자율 + 3%p (최고 연 20.0%)</li>", "spans": []}, {"t": "-", "a": 707, "b": null, "text": "\t\t\t\t\t<li class=\"_bold _deco\">* 연체 발생 시점에 정상이자율이 없는 경우 아래와 같이 적용</li>", "spans": []}, {"t": "-", "a": 708, "b": null, "text": "\t\t\t\t\t<li class=\"_bold _deco _margin\">① 일시불 거래 연체 시 : 거래 발생 시점의 최소 기간(2개월) <br> 유이자할부 이자율</li>", "spans": []}, {"t": "-", "a": 709, "b": null, "text": "\t\t\t\t\t<li class=\"_bold _deco _margin\">② 무이자할부 거래 연체 시 : 거래 발생 시점의 동일한 할부 계약기간 <br> 유이자할부</li>", "spans": []}, {"t": "-", "a": 710, "b": null, "text": "\t\t\t\t\t<li class=\"_deco\"><span class=\"_mark\">※</span>금융상품 이용 전 상품설명서, 홈페이지, 약관 통해 이용조건 확인</li>", "spans": []}, {"t": "-", "a": 711, "b": null, "text": "\t\t\t\t\t<li class=\"_deco\"><span class=\"_mark\">※</span>금융소비자는 금융소비자보호법 제 19조 제1항에 따라 해당 상품 또는 <br>서비스에 대하여 설명을 받을 권리가 있음</li>", "spans": []}, {"t": "-", "a": 712, "b": null, "text": "\t\t\t\t\t<li class=\"_deco\"><span class=\"_mark\">※</span>신용카드 발급이 부적정한 경우(개인신용평점 낮음 등) 카드 발급이 제한될 <br> 수 있음</li>", "spans": []}, {"t": "-", "a": 713, "b": null, "text": "\t\t\t\t\t<li class=\"_deco\"><span class=\"_mark\">※</span>카드 이용대금과 이에 수반되는 모든 수수료를 지정된 대금 결제일에 상환</li>", "spans": []}, {"t": "-", "a": 714, "b": null, "text": "\t\t\t\t\t<li class=\"_bold _deco\"><span class=\"_mark\">※</span>상환 능력에 비해 신용카드 사용액이 과도할 경우 귀하의 개인신용평점이 <br> 하락할 수 있음</li>", "spans": []}, {"t": "-", "a": 715, "b": null, "text": "\t\t\t\t\t<li class=\"_bold _deco\"><span class=\"_mark\">※</span>개인신용평점 하락 시 금융거래 관련된 불이익이 발생할 수 있음</li>", "spans": []}, {"t": "-", "a": 716, "b": null, "text": "\t\t\t\t\t<li class=\"_bold _deco\"><span class=\"_mark\">※</span>일정 기간 원리금을 연체할 경우, 모든 원리금을 변제할 의무가 발생할 수 <br>있음</li>", "spans": []}, {"t": "-", "a": 717, "b": null, "text": "\t\t\t\t</ul>", "spans": []}, {"t": "-", "a": 718, "b": null, "text": "\t\t\t\t<div class=\"_caution_desc\">삼성카드 준법심의필 I3181-26-2827 ( 2026.06.01 ~ 2027.05.31 )</div>", "spans": []}, {"t": " ", "a": 719, "b": 668, "text": "\t\t\t</div>"}, {"t": " ", "a": 720, "b": 669, "text": "\t\t</div>"}, {"t": " ", "a": 721, "b": 670, "text": "\t</div>"}]}], "added": 14, "removed": 65, "same": false, "places": [], "normalized": false}