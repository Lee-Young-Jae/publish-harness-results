, "b": 686, "text": "\t\t\t\t\t\t</div>"}, {"t": " ", "a": 687, "b": 687, "text": "\t\t\t\t\t</li>"}, {"t": " ", "a": 688, "b": 688, "text": "\t\t\t\t</ul>"}]}, {"lines": [{"t": " ", "a": 690, "b": 690, "text": ""}, {"t": " ", "a": 691, "b": 691, "text": "\t\t\t<div class=\"_caution_table\">"}, {"t": " ", "a": 692, "b": 692, "text": "\t\t\t\t<ul>"}, {"t": "-", "a": 693, "b": null, "text": "\t\t\t\t\t<li>上述折扣率仅作参考，各品牌基本优惠上限与等级折扣率可能不同。</li>", "spans": []}, {"t": "-", "a": 694, "b": null, "text": "\t\t\t\t\t<li>会员价为适用额外优惠(合作优惠券，基本优惠，付款优惠券)前的金额。</li>", "spans": []}, {"t": "-", "a": 695, "b": null, "text": "\t\t\t\t\t<li>申请升级后请重新登录以激活等级。</li>", "spans": []}, {"t": "+", "a": null, "b": 693, "text": "\t\t\t\t\t<li>上記の割引率は一例であり、<br>ブランド（商品）ごとに基本特典の<br>最大適用率および会員ランクによる<br>割引率は異なります。</li>", "spans": []}, {"t": "+", "a": null, "b": 694, "text": "\t\t\t\t\t<li>会員価格は追加割引（提携クーポン・基本特典・<br>決済クーポン）の適用前の価格です。</li>", "spans": []}, {"t": "+", "a": null, "b": 695, "text": "\t\t\t\t\t<li>ランクアップ申請完了後、再ログインいただくと<br>ランク特典が適用されます。</li>", "spans": []}, {"t": " ", "a": 696, "b": 696, "text": "\t\t\t\t</ul>"}, {"t": " ", "a": 697, "b": 697, "text": "\t\t\t</div>"}, {"t": " ", "a": 698, "b": 698, "text": ""}, {"t": " ", "a": 699, "b": 699, "text": "\t\t\t<div class=\"_code_inp\">"}, {"t": " ", "a": 700, "b": 700, "text": "\t\t\t\t<div class=\"_area_wrap\">"}, {"t": "-", "a": 701, "b": null, "text": "\t\t\t\t\t<input type=\"text\" data-algnnum=\"Y\" class=\"_pre_input\" name=\"cooperationEvt\" id=\"cooperationEvt\" maxlength=\"\" value=\"\" placeholder=\"请输入优惠券码\" style=\"text-transform:uppercase;\">", "spans": [[137, 139], [140, 144]]}, {"t": "+", "a": null, "b": 701, "text": "\t\t\t\t\t<input type=\"text\" data-algnnum=\"Y\" class=\"_pre_input\" name=\"cooperationEvt\" id=\"cooperationEvt\" maxlength=\"\" value=\"\" placeholder=\"クーポン番号を入力してください。\" style=\"text-transform:uppercase;\">", "spans": [[137, 144], [145, 153]]}, {"t": " ", "a": 702, "b": 702, "text": "\t\t\t\t</div>"}, {"t": " ", "a":