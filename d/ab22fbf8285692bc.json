": 587, "text": "\t\t\t\t\t\t</div>"}, {"t": " ", "a": 590, "b": 588, "text": "\t\t\t\t\t</li>"}, {"t": " ", "a": 591, "b": 589, "text": "\t\t\t\t\t<li class=\"_divider\">"}, {"t": " ", "a": 592, "b": 590, "text": "\t\t\t\t\t\t<div class=\"_label\">"}, {"t": "-", "a": 593, "b": null, "text": "\t\t\t\t\t\t\t<span class=\"_txt\">参与方式</span>", "spans": [[27, 28], [29, 30]]}, {"t": "+", "a": null, "b": 591, "text": "\t\t\t\t\t\t\t<span class=\"_txt\">参加方法</span>", "spans": [[27, 28], [29, 30]]}, {"t": " ", "a": 594, "b": 592, "text": "\t\t\t\t\t\t</div>"}, {"t": " ", "a": 595, "b": 593, "text": "\t\t\t\t\t\t<div class=\"_item\">"}, {"t": "-", "a": 596, "b": null, "text": "\t\t\t\t\t\t\t<span class=\"_txt\">在COLORIZE官方社交媒体（Instagram、小红书、博客等）<br>的合作帖子中确认优惠码（通用认证码）后进行注册</span>", "spans": [[26, 27], [35, 41], [51, 52], [53, 59], [64, 75], [77, 81], [82, 87]]}, {"t": "+", "a": null, "b": 594, "text": "\t\t\t\t\t\t\t<span class=\"_txt\">COLORIZE公式SNS（Instagram・小紅書・ブログなど）の<br>タイアップ投稿で特典番号（共通認証コード）を確認し、登録</span>", "spans": [[34, 39], [49, 50], [51, 59], [60, 61], [65, 77], [78, 79], [80, 85], [86, 93]]}, {"t": " ", "a": 597, "b": 595, "text": "\t\t\t\t\t\t</div>"}, {"t": " ", "a": 598, "b": 596, "text": "\t\t\t\t\t</li>"}, {"t": " ", "a": 599, "b": 597, "text": "\t\t\t\t</ul>"}]}, {"lines": [{"t": " ", "a": 601, "b": 599, "text": ""}, {"t": " ", "a": 602, "b": 600, "text": "\t\t\t<div class=\"_caution_table\">"}, {"t": " ", "a": 603, "b": 601, "text": "\t\t\t\t<ul>"}, {"t": "-", "a": 604, "b": null, "text": "\t\t\t\t\t<li>上述折扣率仅作参考，各品牌基本优惠上限与等级折扣率可能不同。</li>", "spans": []}, {"t": "-", "a": 605, "b": null, "text": "\t\t\t\t\t<li>会员价为适用额外优惠(合作优惠券，基本优惠，付款优惠券)前的金额。</li>", "spans": []}, {"t": "-", "a": 606, "b": null, "text": "\t\t\t\t\t<li>申请升级后请重新登录以激活等级。</li>", "spans": []}, {"t": "+", "a": null, "b": 602, "text": "\t\t\t\t\t<li>", "spans": []}, {"t": "+", "a": null, "b": 603, "text": "\t\t\t\t\t\t上記の割引率は一例であり、ブランド（商品）ごとに基本特典の最大適用率および<br>", "spans": []}, {"t": "+", "a": null, "b": 604, "text": "\t\t\t\t\t\t会員ランクによる割引率は異なります。", "spans": []}, {"t": "+", "a": null, "b": 605, "text": "\t\t\t\t\t</li>", "spans": []}, {"t": "+", "a": null, "b": 606, "text": "\t\t\t\t\t<li>会員価格は追加割引（提携クーポン・基本特典・決済クーポン）の適用前の価格です。</li>", "spans": []}, {"t": "+", "a": null, "b": 607, "text": "\t\t\t\t\t<li>ランクアップ申請完了後、再ログインいただくとランク特典が適用されます。</li>", "spans": []}, {"t": " ", "a": 607, "b": 608, "text": "\t\t\t\t</ul>"}, {"t": " ", "a": 608, "b": 609, "text": "\t\t\t</div>"}, {"t": " ", "a": 609, "b": 610, "text": ""}, {"t": " ", "a": 610, "b": 611, "text": "\t\t\t<div class=\"_code_inp\">"}, {"t": " ", "a": 611, "b": 612, "text": "\t\t\t\t<div class=\"_area_wrap\">"}, {"t": "-", "a": 612, "b": null, "text": "\t\t\t\t\t<input type=\"text\" data-algnnum=\"Y\" class=\"_pre_input\" name=\"cooperationEvt\" id=\"cooperationEvt\" maxlength=\"\" value=\"\" placeholder=\"请输入优惠券码\" style=\"text-transform:uppercase;\" />", "spans": [[137, 139], [140, 144]]}, {"t": "+", "a": null, "b": 613, "text": "\t\t\t\t\t<input type=\"text\" data-algnnum=\"Y\" class=\"_pre_input\" name=\"cooperationEvt\" id=\"cooperationEvt\" maxlength=\"\" value=\"\" placeholder=\"クーポン番号を入力してください。\" style=\"text-transform:uppercase;\" />", "spans": [[137, 144], [145, 153]]}, {"t": " ", "a": 613, "b": 614, "text": "\t\t\t\t</div>"}, {"t": " ", "a": 614, "b": 615, "text": "\t\t\t</div>"}, {"t": " ", "a": 615, "b": 616, "text": ""}, {"t": " ", "a": 616, "b": 617, "text": "\t\t\t<div class=\"_btn_set _submit_btn\">"}, {"t": " ", "a": 617, "b": 618, "text": "\t\t\t\t<div class=\"_area_wrap\">"}, {"t": " ", "a": 618, "b": 619, "text": "\t\t\t\t\t<a href=\"#\" class=\"_ev_fn_submit\">"}, {"t": "-", "a": 619, "b": null, "text": "\t\t\t\t\t\t<span class=\"_name\">领取优惠</span>", "spans": [[26, 30]]}, {"t": "+", "a": null, "b": 620, "text": "\t\t\t\t\t\t<span class=\"_name\">すべてダウンロード</span>", "spans": [[26, 35]]}, {"t": " ", "a": 620, "b": 621, "text": "\t\t\t\t\t\t<span class=\"_sign _init_btn_bg\"><svg xmlns=\"http://